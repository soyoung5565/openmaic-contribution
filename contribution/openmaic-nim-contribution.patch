diff --git a/lib/server/classroom-storage.ts b/lib/server/classroom-storage.ts
index 41e3e8c9..6707fcce 100644
--- a/lib/server/classroom-storage.ts
+++ b/lib/server/classroom-storage.ts
@@ -25,7 +25,27 @@ export async function writeJsonFileAtomic(filePath: string, data: unknown) {
   const tempFilePath = `${filePath}.${process.pid}.${Date.now()}.tmp`;
   const content = JSON.stringify(data, null, 2);
   await fs.writeFile(tempFilePath, content, 'utf-8');
-  await fs.rename(tempFilePath, filePath);
+
+  // Windows: the target file may be briefly held by file watchers / AV scans,
+  // making rename intermittently fail with EPERM/EACCES/EBUSY. Retry with backoff.
+  let lastErr: NodeJS.ErrnoException | null = null;
+  for (let attempt = 0; attempt < 8; attempt++) {
+    try {
+      await fs.rename(tempFilePath, filePath);
+      return;
+    } catch (error) {
+      const code = (error as NodeJS.ErrnoException).code;
+      if (code !== 'EPERM' && code !== 'EACCES' && code !== 'EBUSY') throw error;
+      lastErr = error as NodeJS.ErrnoException;
+      await new Promise((resolve) => setTimeout(resolve, 50 * (attempt + 1)));
+    }
+  }
+  try {
+    await fs.unlink(tempFilePath);
+  } catch {
+    /* ignore cleanup failure */
+  }
+  throw lastErr;
 }
 
