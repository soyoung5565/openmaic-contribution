@@ -277,6 +277,11 @@ export async function generateTTSForClassroom(
     return;
   }
 
+  // Collect TTS tasks first (splitting/filtering stay synchronous), then
+  // synthesize with bounded concurrency: serial synthesis dominated lesson
+  // generation time (upstream TTS handles several parallel requests fine).
+  const ttsTasks: Array<{ speechAction: ServerTransportSpeechAction; audioId: string }> = [];
+
   for (const scene of scenes) {
     if (!scene.actions) continue;
 
@@ -293,8 +298,15 @@ export async function generateTTSForClassroom(
       // Server transport emits the derived id plus the serving URL; the
       // client-side converter collapses the pair into one pool asset on
       // first load. Browser generation allocates pool ids directly.
-      const audioId = `tts_s${sceneOrder}_${action.id}`;
+      ttsTasks.push({ speechAction, audioId: `tts_s${sceneOrder}_${action.id}` });
+    }
+  }
 
+  const ttsConcurrency = Math.max(1, parseInt(process.env.TTS_CONCURRENCY || '4', 10) || 4);
+  let nextTaskIndex = 0;
+  const worker = async () => {
+    while (nextTaskIndex < ttsTasks.length) {
+      const { speechAction, audioId } = ttsTasks[nextTaskIndex++];
       try {
         const result = await generateTTS(
